# Bot host only. The browser game and Vercel static build need no secrets.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register in one server first; omit for global registration.
DISCORD_TEST_GUILD_ID=
# Fine-grained GitHub token restricted to grapevinerpg, Contents read/write.
GAME_GITHUB_TOKEN=
GAME_GITHUB_REPOSITORY=zigzageer/grapevinerpg
GAME_GITHUB_BRANCH=main
GAME_BASE_URL=https://adventures-of-mint.vercel.app
OPENAI_API_KEY=
GAME_IMAGE_MODEL=gpt-image-2.6-flare
# Optional bot-owner Discord IDs allowed to edit games without Manage Server.
GAME_ALLOWED_USER_IDS=
