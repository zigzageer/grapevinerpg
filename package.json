    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.8.2",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
