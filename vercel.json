{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/studio/:path*",
      "destination": "/api/studio?route=:path*"
    },
    {
      "source": "/:server([a-z0-9-]+-[0-9]{17,20})",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/games/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
